{
  "name": "chonthenao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chọn Thẻ Nào — gợi ý thẻ tín dụng và ngân hàng theo nhu cầu chi tiêu. Static site.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate-data": "node scripts/validate-data.js",
    "check-disclaimer": "node scripts/check-disclaimer.js",
    "e2e": "playwright test"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-plugin-jsdoc": "^65.5.4",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
